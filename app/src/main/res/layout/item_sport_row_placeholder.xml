<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:importantForAccessibility="no"
     android:minHeight="@dimen/light_sport_row_min_height"
    android:orientation="horizontal"
     android:paddingStart="@dimen/light_row_horizontal_padding"
     android:paddingTop="@dimen/light_row_vertical_padding"
     android:paddingEnd="@dimen/light_row_horizontal_padding"
     android:paddingBottom="@dimen/light_row_vertical_padding">

    <View
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_activity_icon" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
         android:layout_marginStart="@dimen/light_sport_content_gap"
        android:layout_weight="1"
        android:orientation="vertical">

        <View
            android:layout_width="140dp"
            android:layout_height="16dp"
            android:background="@drawable/bg_placeholder_bar" />

        <View
            android:layout_width="90dp"
            android:layout_height="14dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_placeholder_bar" />
    </LinearLayout>

</LinearLayout>

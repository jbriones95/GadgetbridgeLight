<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:context=".widgets.impl.GaugeWidget">

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/gauge_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- The existing draw contract still uses these views to format values and fractions. -->
    <ImageView
        android:id="@+id/gauge_bar"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/gauge_value"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="invisible"
        android:text="@string/stats_empty_value" />

    <TextView
        android:id="@+id/gauge_label"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="invisible"
        android:text="@string/no_data" />
</FrameLayout>

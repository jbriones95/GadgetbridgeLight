<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingEnd="22dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/find_device_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
         android:textAppearance="@style/TextAppearance.App.LightPhone.RowTitle" />

    <TextView
        android:id="@+id/find_device_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="16dp"
        android:text="@string/earfun_find_headphones_hint"
         android:textAppearance="@style/TextAppearance.App.LightPhone.RowDetail"
         android:textColor="?attr/colorOnSurfaceVariant" />

    <RadioGroup
        android:id="@+id/find_device_target_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/find_device_target_all"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
             android:minHeight="56dp"
             android:buttonTint="?attr/colorOnSurface"
             android:textAppearance="@style/TextAppearance.App.LightPhone.RowTitle"
             android:text="@string/both_earbuds" />

        <RadioButton
            android:id="@+id/find_device_target_left"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
             android:minHeight="56dp"
             android:buttonTint="?attr/colorOnSurface"
             android:textAppearance="@style/TextAppearance.App.LightPhone.RowTitle"
             android:text="@string/left_earbud" />

        <RadioButton
            android:id="@+id/find_device_target_right"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
             android:minHeight="56dp"
             android:buttonTint="?attr/colorOnSurface"
             android:textAppearance="@style/TextAppearance.App.LightPhone.RowTitle"
             android:text="@string/right_earbud" />

    </RadioGroup>

</LinearLayout>

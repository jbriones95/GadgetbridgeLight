<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".activities.ControlCenterv2">

    <com.google.android.material.appbar.AppBarLayout
         android:id="@+id/appbarlayout"
         android:layout_width="match_parent"
         android:layout_height="@dimen/light_bar_height"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/light_bar_height"
             android:background="?attr/main_bar_bg"
             android:minHeight="0dp"
             app:titleCentered="true"
             app:subtitleCentered="true" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/dashboard_swipe_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/appbarlayout"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav_bar">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/dashboard_viewpager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <View
        android:id="@+id/toolbar_shade"
        android:layout_width="0dp"
        android:layout_height="8dp"
        android:background="?attr/bar_shade"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appbarlayout" />

    <View
        android:id="@+id/bottom_nav_shade"
        android:layout_width="0dp"
        android:layout_height="8dp"
        android:background="?attr/bar_shade"
        android:visibility="gone"
        android:rotation="180"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav_bar" />

    <View
        android:id="@+id/bottom_nav_divider"
        android:layout_width="0dp"
        android:layout_height="@dimen/light_rule_thickness"
        android:background="?attr/bottom_bar_divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav_bar" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
         android:id="@+id/bottom_nav_bar"
        style="@style/Widget.App.LightPhone.BottomNavigation"
        android:layout_width="match_parent"
         android:layout_height="@dimen/light_bottom_bar_height"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        android:background="?attr/main_bar_bg"
         android:foreground="@null"
         app:itemTextColor="@color/navigation_item_tint"
         app:itemRippleColor="@null"
         app:itemActiveIndicatorStyle="@null"
        app:labelVisibilityMode="unlabeled"
        app:itemHorizontalTranslationEnabled="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/bottom_nav_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>

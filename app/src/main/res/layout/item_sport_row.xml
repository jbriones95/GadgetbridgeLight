<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
     android:minHeight="@dimen/light_sport_row_min_height"
    android:orientation="horizontal"
     android:paddingStart="@dimen/light_row_horizontal_padding"
     android:paddingTop="@dimen/light_row_vertical_padding"
     android:paddingEnd="@dimen/light_row_horizontal_padding"
     android:paddingBottom="@dimen/light_row_vertical_padding">

    <nodomain.freeyourgadget.gadgetbridge.activities.workouts.ActivityIconView
        android:id="@+id/sport_row_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:importantForAccessibility="no"
        app:srcCompat="@drawable/ic_activity_unknown" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
         android:layout_marginStart="@dimen/light_sport_content_gap"
         android:layout_marginEnd="@dimen/light_sport_content_gap"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/sport_row_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
             android:textAppearance="@style/TextAppearance.App.LightPhone.RowTitle"
            tools:text="Running" />

        <TextView
            android:id="@+id/sport_row_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
             android:layout_marginTop="@dimen/light_sport_detail_gap"
            android:ellipsize="end"
            android:maxLines="1"
             android:textAppearance="@style/TextAppearance.App.LightPhone.RowDetail"
            tools:text="128 activities" />
    </LinearLayout>

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        app:srcCompat="@drawable/ic_chevron_1_right"
        app:tint="?attr/colorOutline" />

</LinearLayout>
